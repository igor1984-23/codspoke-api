# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/codspoke

# JWT
JWT_SECRET=change-me-to-a-minimum-32-character-secret
JWT_EXPIRES_IN=7d

# Email (optional — dev falls back to console log)
RESEND_API_KEY=

# Edsofa
EDSOFA_API_KEY=
EDSOFA_WEBHOOK_SECRET=

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
